# Bu dosyayi .env olarak kopyalayin ve kendi anahtarlarinizi girin:
#   Windows : copy .env.example .env
#   Linux/Mac: cp .env.example .env
#
# .env dosyasi .gitignore icinde oldugu icin depoya gonderilmez.

# OpenAI API anahtari - DALL-E 3 icin ZORUNLU
# https://platform.openai.com/api-keys adresinden olusturulur.
OPENAI_API_KEY=

# Hugging Face erisim anahtari - OPSIYONEL
# Sadece "Hugging Face" modeli secilirse kullanilir.
# https://huggingface.co/settings/tokens adresinden olusturulur.
HF_API_KEY=

# Uretilen gorsellerin otomatik kaydedilecegi klasor - OPSIYONEL
# Bos birakilirsa proje icindeki "fotolar" klasoru kullanilir.
OUTPUT_DIR=

# Hugging Face model kimligi - OPSIYONEL
HF_MODEL_ID=black-forest-labs/FLUX.1-dev

# Hugging Face uc noktasinin kok adresi - OPSIYONEL
# Yorum satiri olarak birakilirsa kodun icindeki varsayilan kullanilir.
# Saglayici adresi degisirse basindaki # isaretini kaldirip guncelleyin.
# HF_API_URL=https://router.huggingface.co/hf-inference/models
